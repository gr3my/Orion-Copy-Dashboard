# Backend API base URL. Server-side only — the dashboard proxies all backend
# calls through Next.js route handlers, so this URL never reaches the browser.
ORION_API_URL=http://127.0.0.1:8080

# Session signing secret. REQUIRED in production: at least 32 characters.
# Generate with: openssl rand -hex 32   (prints 64 hex chars)
# Placeholder values (CHANGE_ME, YOUR_SECRET, ...) and short values are
# REJECTED at login time in production. Dev may start with weak values but
# every auth response carries a loud warning.
# NOTE: CHANGE_ME below is intentionally rejected — copying this file verbatim
# will refuse to authenticate in production. Replace both values first.
ORION_DASHBOARD_SESSION_SECRET=CHANGE_ME

# Bootstrap admin key. REQUIRED: at least 20 characters.
# Same placeholder/short-value rejection applies. After first sign-in, mint
# scoped operator keys (Operators / API Keys pages) for day-to-day use.
ORION_DASHBOARD_ADMIN_KEY=CHANGE_ME

# Display name shown in the UI.
ORION_DASHBOARD_NAME=Orion Copy Dashboard
# Set to false to disable the unauthenticated status page.
ORION_PUBLIC_STATUS_ENABLED=true
# Default region label used when the backend omits one.
ORION_DEFAULT_SERVER_REGION=local

# Reverse-proxy trust. Default false: client IPs come from the direct
# connection (login rate limiting cannot be spoofed via X-Forwarded-For).
# Set to true ONLY when running behind a reverse proxy that strips/spoofs
# client-supplied forwarding headers (nginx/caddy/Cloudflare). See README.
ORION_TRUST_PROXY_HEADERS=false

# Set to true to serve clearly-labeled synthetic fixtures for local UI work.
# Never enable in production.
ORION_MOCK=false
